# Optional: enables the LLM backend. Unset = rule-based, no data leaves the machine.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Comma-separated. Never "*" — a paid key sits behind this API.
ALLOWED_ORIGINS=http://localhost:5173

# Per-User (Client-ID) limits on the three LLM-backed endpoints.
LIMIT_JOB_PROFILE=3/day
LIMIT_CV=15/day
LIMIT_ANALYSIS=3/day

# Password embedded in the URL (e.g. ?pwd=class2024) to access the application
ACCESS_PASSWORD=class2024
