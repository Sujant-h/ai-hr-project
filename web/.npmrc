# openapi-typescript@7.13.0 declares peer typescript@^5.x, but this project
# pins typescript@~6.0.2. Without this flag both `npm install` and `npm ci`
# fail with ERESOLVE, so nobody can install the project from a clean clone.
#
# The conflict is stale upstream metadata, not a real incompatibility: 7.13.0
# is the latest release, no version declares TS 6 support yet, and running it
# against typescript 6.0.3 regenerates src/api/types.ts byte-identically.
# `npm run gen:types` is the check — if it ever fails or produces a diff on a
# clean tree, revisit this instead of trusting the flag.
legacy-peer-deps=true
